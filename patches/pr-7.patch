@@ -0,0 +1,130 @@
+/*  SPDX-License-Identifier: GPL-2.0-or-later  */
+/*!********************************************************************
+
+  Audacity: A Digital Audio Editor
+
+  @file PlaybackRestartTests.cpp
+
+  Tests for restarting playback after tracks are added (e.g. by drag & drop)
+
+**********************************************************************/
+#include "PlaybackRestart.h"
+
+#include <catch2/catch.hpp>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+class MockHost final : public PlaybackRestartHost
+{
+public:
+   bool playing = false;
+   bool paused = false;
+   bool looping = false;
+   double time = 0.0;
+   std::vector<std::string> calls;
+   double playedFrom = -1.0;
+   bool playedLooping = false;
+
+   bool Playing() const override { return playing; }
+   bool Paused() const override { return paused; }
+   bool Looping() const override { return looping; }
+   double StreamTime() const override { return time; }
+   void Stop() override { calls.push_back("stop"); playing = false; }
+   void Play(double t, bool loop) override
+   {
+      calls.push_back("play");
+      playedFrom = t;
+      playedLooping = loop;
+      playing = true;
+   }
+};
+} // namespace
+
+TEST_CASE("RestartPlaybackAfter: restarts normal playback from current time")
+{
+   MockHost host;
+   host.playing = true;
+   host.time = 3.5;
+   bool modified = false;
+
+   const bool result = RestartPlaybackAfter(host, [&] {
+      modified = true;
+      host.time = 99.0; // time moved on during import must not be used
+      return true;
+   });
+
+   REQUIRE(result);
+   REQUIRE(modified);
+   REQUIRE(host.calls == std::vector<std::string>{ "stop", "play" });
+   REQUIRE(host.playedFrom == 3.5);
+   REQUIRE_FALSE(host.playedLooping);
+}
+
+TEST_CASE("RestartPlaybackAfter: keeps loop mode")
+{
+   MockHost host;
+   host.playing = true;
+   host.looping = true;
+   host.time = 1.25;
+
+   REQUIRE(RestartPlaybackAfter(host, [] { return true; }));
+   REQUIRE(host.calls == std::vector<std::string>{ "stop", "play" });
+   REQUIRE(host.playedFrom == 1.25);
+   REQUIRE(host.playedLooping);
+}
+
+TEST_CASE("RestartPlaybackAfter: does nothing when not playing")
+{
+   MockHost host;
+   bool modified = false;
+
+   REQUIRE(RestartPlaybackAfter(host, [&] { modified = true; return true; }));
+   REQUIRE(modified);
+   REQUIRE(host.calls.empty());
+}
+
+TEST_CASE("RestartPlaybackAfter: does not restart while paused")
+{
+   MockHost host;
+   host.playing = true;
+   host.paused = true;
+
+   REQUIRE(RestartPlaybackAfter(host, [] { return true; }));
+   REQUIRE(host.calls.empty());
+}
+
+TEST_CASE("RestartPlaybackAfter: failed modification leaves playback alone")
+{
+   MockHost host;
+   host.playing = true;
+   host.time = 2.0;
+
+   REQUIRE_FALSE(RestartPlaybackAfter(host, [] { return false; }));
+   REQUIRE(host.calls.empty());
+   REQUIRE(host.playing);
+}
+
+TEST_CASE("RestartPlaybackAfter: no restart if playback ended meanwhile")
+{
+   MockHost host;
+   host.playing = true;
+
+   REQUIRE(RestartPlaybackAfter(host, [&] {
+      host.playing = false; // clip finished while importing
+      return true;
+   }));
+   REQUIRE(host.calls.empty());
+}
+
+TEST_CASE("RestartPlaybackAfter: propagates exceptions without restarting")
+{
+   MockHost host;
+   host.playing = true;
+
+   REQUIRE_THROWS_AS(
+      RestartPlaybackAfter(host, []() -> bool { throw std::runtime_error{ "x" }; }),
+      std::runtime_error);
+   REQUIRE(host.calls.empty());
+}
diff --git a/src/DropTarget.cpp b/src/DropTarget.cpp
index a4ae183522c..e5e6c91c781 100644
--- a/src/DropTarget.cpp
+++ b/src/DropTarget.cpp
@@ -13,8 +13,12 @@
 #include <wx/dnd.h>
 
 #include "AudacityException.h"
+#include "AudioIO.h"
 #include "FileNames.h"
+#include "PlaybackRestart.h"
 #include "Project.h"
+#include "ProjectAudioIO.h"
+#include "ProjectAudioManager.h"
 #include "ProjectFileManager.h"
 #include "TrackPanel.h"
 
@@ -45,6 +49,33 @@ class FileObject final : public wxFileDataObject
    }
 };
 
+namespace {
+class ProjectPlaybackRestartHost final : public PlaybackRestartHost
+{
+public:
+   explicit ProjectPlaybackRestartHost(AudacityProject& project)
+      : mProject{ project }
+      , mManager{ ProjectAudioManager::Get(project) }
+   {}
+   bool Playing() const override { return mManager.Playing(); }
+   bool Paused() const override { return AudioIO::Get()->IsPaused(); }
+   bool Looping() const override { return mManager.Looping(); }
+   double StreamTime() const override { return AudioIO::Get()->GetStreamTime(); }
+   void Stop() override { mManager.Stop(); }
+   void Play(double startTime, bool looping) override
+   {
+      auto options = ProjectAudioIO::GetDefaultOptions(mProject, looping);
+      options.pStartTime.emplace(startTime);
+      mManager.PlayPlayRegion(
+         SelectedRegion(startTime, startTime), options,
+         looping ? PlayMode::loopedPlay : PlayMode::normalPlay);
+   }
+private:
+   AudacityProject& mProject;
+   ProjectAudioManager& mManager;
+};
+} // namespace
+
 class DropTarget final : public wxFileDropTarget
 {
 public:
@@ -156,8 +187,14 @@ class DropTarget final : public wxFileDropTarget
    {
       // Experiment shows that this function can be reached while there is no
       // catch block above in wxWidgets.  So stop all exceptions here.
-      return GuardedCall<bool>(
-         [&] { return ProjectFileManager::Get(*mProject).Import(filenames); });
+      return GuardedCall<bool>([&] {
+         // Playback uses a snapshot of the tracks taken when it started, so
+         // to hear the dropped files, restart playback from where it was.
+         ProjectPlaybackRestartHost host{ *mProject };
+         return RestartPlaybackAfter(host, [&] {
+            return ProjectFileManager::Get(*mProject).Import(filenames);
+         });
+      });
    }
 
